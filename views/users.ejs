<%- include('partials/header') %>

<main class="container">
  <%- include('partials/nav') %>

  <h1>Utilisateurs</h1>

  <h2>Ajouter un utilisateur</h2>
  <form id="create-form">
    <label for="username">Nom d'utilisateur</label>
    <input type="text" id="username" required>

    <label for="email">Email</label>
    <input type="email" id="email" required>

    <label for="password">Mot de passe (8 caractères minimum)</label>
    <input type="password" id="password" minlength="8" required autocomplete="new-password">

    <button type="submit">Créer</button>
  </form>

  <p id="message" class="error"></p>

  <h2>Liste des utilisateurs</h2>
  <table>
    <thead>
      <tr>
        <th>Nom d'utilisateur</th>
        <th>Email</th>
        <th>Nouveau mot de passe</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(function(user) { %>
        <tr data-email="<%= user.email %>">
          <td><input type="text" class="f-username" value="<%= user.username %>"></td>
          <td>
            <a href="/users-view/<%= encodeURIComponent(user.email) %>"><%= user.email %></a>
            <% if (user.email === currentEmail) { %> (vous)<% } %>
          </td>
          <td>
            <input type="password" class="f-password" placeholder="Laisser vide pour ne pas changer" autocomplete="new-password">
          </td>
          <td>
            <button class="btn-update">Modifier</button>
            <% if (user.email !== currentEmail) { %>
              <button class="btn-delete">Supprimer</button>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</main>

<script src="/js/users.js"></script>
<%- include('partials/footer') %>