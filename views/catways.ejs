<%- include('partials/header') %>

<main class="container">
  <%- include('partials/nav') %>

  <h1>Catways</h1>

  <h2>Ajouter un catway</h2>
  <form id="create-form">
    <label for="catwayNumber">Numéro</label>
    <input type="number" id="catwayNumber" min="1" required>

    <label for="catwayType">Type</label>
    <select id="catwayType" required>
      <option value="short">short</option>
      <option value="long">long</option>
    </select>

    <label for="catwayState">État</label>
    <input type="text" id="catwayState" required>

    <button type="submit">Créer</button>
  </form>

  <p id="message" class="error"></p>

  <h2>Liste des catways</h2>
  <table>
    <thead>
      <tr>
        <th>Numéro</th>
        <th>Type</th>
        <th>État</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% catways.forEach(function(catway) { %>
        <tr>
          <td><a href="/catways-view/<%= catway.catwayNumber %>"><%= catway.catwayNumber %></a></td>
          <td><%= catway.catwayType %></td>
          <td>
            <input type="text" value="<%= catway.catwayState %>"
                   data-state-for="<%= catway.catwayNumber %>">
          </td>
          <td>
            <button class="btn-update" data-number="<%= catway.catwayNumber %>">Modifier l'état</button>
            <button class="btn-delete" data-number="<%= catway.catwayNumber %>">Supprimer</button>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</main>

<script src="/js/catways.js"></script>
<%- include('partials/footer') %>